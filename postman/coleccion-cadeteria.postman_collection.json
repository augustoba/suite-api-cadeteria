    {
      "name": "5. GET /api/pedidos/me/{id}",
      "item": [
        {
          "name": "P3 - Historial del cadete (guarda pedidoId, no cuenta como caso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"el cadete tiene al menos un pedido finalizado\", function () {",
                  "  pm.expect(pm.response.json().pedidos).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "var pedidos = pm.response.json().pedidos || [];",
                  "if (pedidos.length) { pm.collectionVariables.set(\"pedidoId\", pedidos[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCadete}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/me/historial",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos",
                "me",
                "historial"
              ]
            },
            "description": "Toma el id de un pedido propio para el caso 13. Si el cadete no tiene pedidos, cargar pedidoId a mano en las variables."
          }
        },
        {
          "name": "13 - Pedido propio -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"devuelve el pedido pedido\", function () { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"pedidoId\")); });",
                  "pm.test(\"incluye número de pedido\", function () { pm.expect(pm.response.json()).to.have.property(\"numero\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCadete}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/me/{{pedidoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos",
                "me",
                "{{pedidoId}}"
              ]
            },
            "description": "Detalle de un pedido del cadete que inició sesión."
          }
        },
        {
          "name": "14 - Pedido que no existe -> 404 NO_ENCONTRADO",
