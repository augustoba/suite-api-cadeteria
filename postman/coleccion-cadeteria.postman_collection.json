  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Chequeos comunes a todos los requests (reemplazan código repetido en cada caso)",
          "const maxMs = parseInt(pm.variables.get('maxMs') || '1500', 10);",
          "pm.test('Tiempo de respuesta < ' + maxMs + ' ms', function () { pm.expect(pm.response.responseTime).to.be.below(maxMs); });",
          "pm.test('Content-Type es JSON', function () { pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'); });",
          "if (pm.response.code >= 400) {",
          "  pm.test('Error con formato estándar (status, error, codigo, message)', function () {",
          "    const r = pm.response.json();",
          "    pm.expect(r.status).to.eql(pm.response.code);",
          "    pm.expect(r.error).to.be.a('string').and.not.empty;",
          "    pm.expect(r.codigo).to.be.a('string').and.not.empty;",
          "    pm.expect(r.message).to.be.a('string').and.not.empty;",
          "  });",
          "}"
        ]
      }
    }
  ]
