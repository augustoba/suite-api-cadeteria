              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/cadetes/{{idInexistente}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "cadetes",
                "{{idInexistente}}"
              ]
            },
            "description": "Mensaje esperado: \"Cadete no encontrado: no-existe-99999\""
          }
        },
        {
          "name": "09 - Con token de cadete (sin permiso) -> 403 SIN_PERMISO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"codigo = SIN_PERMISO\", function () { pm.expect(pm.response.json().codigo).to.eql(\"SIN_PERMISO\"); });",
                  "console.log(pm.info.requestName + \" -> \" + pm.response.code + \" \" + pm.response.json().codigo + \": \" + pm.response.json().message);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCadete}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/cadetes/{{cadeteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "cadetes",
                "{{cadeteId}}"
              ]
            },
            "description": "Un cadete no puede entrar a las rutas del panel. Mensaje esperado: \"No tenés permiso para hacer eso.\""
          }
        }
      ]
    },
    {
      "name": "4. PATCH /api/cadetes/me/estado",
      "item": [
        {
          "name": "10 - Estado válido -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"devuelve al mismo cadete\", function () { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"cadeteId\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
